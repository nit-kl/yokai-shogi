{
  "name": "yokai-shogi",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node test/e2e/run.mjs",
    "images": "node scripts/optimize-images.mjs",
    "api:dev": "wrangler dev --config server/wrangler.jsonc",
    "api:deploy": "wrangler deploy --config server/wrangler.jsonc",
    "pages:deploy": "npm run build && wrangler pages deploy client/dist --project-name=yokai-shogi"
  },
  "devDependencies": {
    "playwright": "^1.53.0",
    "sharp": "^0.34.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.20.0"
  }
}
