{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default desktop capabilities for Hyakkiban",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-get-steam-session-ticket",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://yokai-shogi.nit-games.com/*" },
        { "url": "https://nit-games.com/*" },
        { "url": "https://www.nit-games.com/*" },
        { "url": "https://discord.gg/*" },
        { "url": "https://x.com/*" },
        { "url": "https://twitter.com/*" },
        { "url": "https://store.steampowered.com/*" }
      ]
    }
  ]
}
