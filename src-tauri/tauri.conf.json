{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "妖怪将棋",
  "version": "0.1.0",
  "identifier": "com.nitgames.yokai-shogi",
  "build": {
    "beforeDevCommand": "npm run dev:steam",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:steam:offline",
    "frontendDist": "../client/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "妖怪将棋",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; media-src 'self' blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self' https://api.yokai-shogi.nit-games.com https://*.workers.dev wss://api.yokai-shogi.nit-games.com wss://*.workers.dev https://*.ingest.sentry.io"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
