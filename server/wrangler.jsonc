// 百鬼盤 API(Cloudflare Workers + Hono + D1)
// ローカル開発: npm run api:dev(ローカルD1。マイグレーション: npm run db:migrate:local)
// シークレット: JWT_SECRET(必須)/ TURNSTILE_SECRET_KEY(任意: 未設定なら検証スキップ)
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yokai-shogi-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "yokai-shogi-db-staging",
      "database_id": "9f69cb38-cd54-4300-8d8d-9adcc0f8ad58",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "BATTLE", "class_name": "BattleRoom" },
      { "name": "MATCHMAKER", "class_name": "Matchmaker" }
    ]
  },
  "analytics_engine_datasets": [
    { "binding": "METRICS", "dataset": "yokai_shogi_metrics_local" }
  ],
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["BattleRoom", "Matchmaker"] }
  ],
  "triggers": {
    "crons": ["0 19 * * *"] // JST 04:00(日次リセットに合わせる: doc 08)
  },
  "vars": {
    "ALLOWED_ORIGINS": "http://localhost:5173,http://localhost:4173,http://localhost:1420,http://tauri.localhost,https://tauri.localhost,tauri://localhost",
    "MAINTENANCE": "0",
    "ADS_REWARD_ENABLED": "1",
    "ADS_REWARD_PROVIDER": "mock",
    "STEAM_AUTH_MOCK": "1"
  },
  "env": {
    // ステージング: wrangler deploy --env staging
    "staging": {
      "name": "yokai-shogi-api-staging",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "yokai-shogi-db-staging",
          "database_id": "9f69cb38-cd54-4300-8d8d-9adcc0f8ad58",
          "migrations_dir": "migrations"
        }
      ],
      "durable_objects": {
        "bindings": [
          { "name": "BATTLE", "class_name": "BattleRoom" },
          { "name": "MATCHMAKER", "class_name": "Matchmaker" }
        ]
      },
      "analytics_engine_datasets": [
        { "binding": "METRICS", "dataset": "yokai_shogi_metrics_staging" }
      ],
      "triggers": { "crons": ["0 19 * * *"] },
      "vars": {
        "ALLOWED_ORIGINS": "http://localhost:5173,http://localhost:4173,http://localhost:1420,http://tauri.localhost,https://tauri.localhost,tauri://localhost,https://yokai-shogi-staging.pages.dev",
        "MAINTENANCE": "0",
        "ADS_REWARD_ENABLED": "1",
        "ADS_REWARD_PROVIDER": "mock",
        "STEAM_AUTH_MOCK": "1"
      }
    },
    // 本番: wrangler deploy --env production
    "production": {
      "name": "yokai-shogi-api-production",
      "routes": [
        {
          "pattern": "api.yokai-shogi.nit-games.com",
          "custom_domain": true
        }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "yokai-shogi-db",
          "database_id": "222c5403-5215-408f-b651-8eaf867156a1",
          "migrations_dir": "migrations"
        }
      ],
      "durable_objects": {
        "bindings": [
          { "name": "BATTLE", "class_name": "BattleRoom" },
          { "name": "MATCHMAKER", "class_name": "Matchmaker" }
        ]
      },
      "analytics_engine_datasets": [
        { "binding": "METRICS", "dataset": "yokai_shogi_metrics_production" }
      ],
      "triggers": { "crons": ["0 19 * * *"] },
      "vars": {
        "ALLOWED_ORIGINS": "https://yokai-shogi.nit-games.com,https://yokai-shogi.pages.dev,http://tauri.localhost,https://tauri.localhost,tauri://localhost",
        "MAINTENANCE": "0",
        "ADS_REWARD_ENABLED": "0",
        "ADS_REWARD_PROVIDER": "mock",
        "STEAM_AUTH_MOCK": "0"
      }
    }
  }
}
